# Set environment variables in your deployment; server.py does not load .env files.
# Docker Compose reads this file only after you copy it to .env.
ALLOWED_HOSTS=solveny.dev,www.solveny.dev
PICKABLE_PUBLIC_URL=https://solveny.dev
PICKABLE_MCP_SCAN_ENABLED=0
# Required for optional MCP scan creation; minimum 32 ASCII characters.
# Generate a secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PICKABLE_AGENT_API_KEY=
PICKABLE_SCANS_PER_HOUR=5
PICKABLE_GLOBAL_SCANS_PER_HOUR=30
DB_PATH=./data/scan.db
