# Set environment variables in your deployment; server.py does not load .env files.
# Docker Compose reads this file only after you copy it to .env.
ALLOWED_HOSTS=solveny.dev,www.solveny.dev
PICKABLE_PUBLIC_URL=https://solveny.dev
PICKABLE_MCP_SCAN_ENABLED=0
# Required for optional MCP scan creation; minimum 32 ASCII characters.
# Generate a secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PICKABLE_AGENT_API_KEY=
PICKABLE_SCANS_PER_HOUR=5
PICKABLE_GLOBAL_SCANS_PER_HOUR=30
# Spend guards: reuse a completed same-domain analysis for this many hours
# (0 disables) instead of paying for an identical model call per visitor.
PICKABLE_INTEL_REUSE_HOURS=24
# Paid deep-research calls admitted per UTC day; excess gets a 409 and keeps
# the free preliminary + short analysis. Short analyses stay unlimited.
PICKABLE_DEEP_PER_DAY=50
DB_PATH=./data/scan.db
# Ollama origin (no API key required). Compose default reaches Ollama on the VPS host.
# For local `python3 server.py`, change this to http://127.0.0.1:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Optional hosted analysis. One OpenAI key can access both configured models.
INTELLIGENCE_PROVIDER=
OPENAI_API_KEY=
# Quick analysis uses the lower-cost model; deep analysis is user-triggered.
OPENAI_QUICK_MODEL=gpt-6-luna
OPENAI_DEEP_MODEL=gpt-6.1-sol
# Legacy override: if set, this remains the quick model unless OPENAI_QUICK_MODEL is set.
OPENAI_MODEL=
# Origin lockdown (Cloudflare on). Trusted reverse proxies for client-IP
# restore; empty = loopback + docker private ranges (Traefik default).
TRUSTED_PROXIES=
# Set to 1 only AFTER Cloudflare proxy (orange cloud) is ON. Rejects
# direct-to-origin requests without Cloudflare edge headers (/api/health exempt).
PICKABLE_REQUIRE_CF=0
