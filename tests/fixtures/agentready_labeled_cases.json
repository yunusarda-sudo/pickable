{
  "cases": [
    {
      "check": "contentSignals",
      "description": "robots.txt declares a parseable policy including train=no (T04). Policy value itself is not scored.",
      "domain": "signals-pass.example.com",
      "expected_applicability": "APPLICABLE",
      "expected_status": "PASS",
      "id": "CS-01",
      "mocks": {
        "/robots.txt": {
          "body": "User-agent: *\nContent-Signal: search=yes, ai-input=no, ai-train=no\nAllow: /\n",
          "status": 200
        }
      }
    },
    {
      "check": "contentSignals",
      "description": "robots.txt retrieved but declares no Content-Signal.",
      "domain": "signals-missing.example.com",
      "expected_applicability": "APPLICABLE",
      "expected_status": "FAIL",
      "id": "CS-02",
      "mocks": {
        "/robots.txt": {
          "body": "User-agent: *\nAllow: /\n",
          "status": 200
        }
      }
    },
    {
      "check": "contentSignals",
      "description": "robots.txt hard-errors; retry, do not claim absence.",
      "domain": "signals-error.example.com",
      "expected_applicability": "UNDETERMINED",
      "expected_status": "ERROR",
      "id": "CS-03",
      "mocks": {
        "/robots.txt": {
          "body": "",
          "status": 503
        }
      }
    },
    {
      "check": "contentSignals",
      "description": "robots.txt unreachable (T05/T11). Timeout is not absence proof.",
      "domain": "signals-timeout.example.com",
      "expected_applicability": "UNDETERMINED",
      "expected_status": "ERROR",
      "id": "CS-04",
      "mocks": {
        "/robots.txt": {
          "error": "TimeoutError: Request timed out"
        }
      }
    },
    {
      "check": "contentSignals",
      "description": "robots.txt 404: fetched, no policy declared.",
      "domain": "signals-404.example.com",
      "expected_applicability": "APPLICABLE",
      "expected_status": "FAIL",
      "id": "CS-05",
      "mocks": {
        "/robots.txt": {
          "body": "",
          "status": 404
        }
      }
    },
    {
      "check": "oauthDiscovery",
      "description": "Real AS metadata: https issuer, matching host, working endpoints.",
      "domain": "auth-pass.example.com",
      "expected_applicability": "APPLICABLE",
      "expected_status": "PASS",
      "id": "OD-01",
      "mocks": {
        "/.well-known/oauth-authorization-server": {
          "body": "{\"issuer\": \"https://auth-pass.example.com\", \"authorization_endpoint\": \"https://auth-pass.example.com/authorize\", \"token_endpoint\": \"https://auth-pass.example.com/token\", \"jwks_uri\": \"https://auth-pass.example.com/jwks.json\"}",
          "content_type": "application/json",
          "status": 200
        }
      }
    },
    {
      "check": "oauthDiscovery",
      "description": "T03: HTTP 200 but issuer points at another system.",
      "domain": "auth-evil.example.com",
      "expected_applicability": "APPLICABLE",
      "expected_status": "FAIL",
      "id": "OD-02",
      "mocks": {
        "/.well-known/oauth-authorization-server": {
          "body": "{\"issuer\": \"https://auth.evil.org\", \"authorization_endpoint\": \"https://auth.evil.org/auth\", \"token_endpoint\": \"https://auth.evil.org/token\"}",
          "content_type": "application/json",
          "status": 200
        },
        "/.well-known/openid-configuration": {
          "body": "",
          "status": 404
        }
      }
    },
    {
      "check": "oauthDiscovery",
      "description": "T01: static site, no AS at standard paths.",
      "domain": "noauth.example.com",
      "expected_applicability": "NOT_APPLICABLE",
      "expected_status": "NOT_APPLICABLE",
      "id": "OD-03",
      "mocks": {
        "/.well-known/oauth-authorization-server": {
          "body": "",
          "status": 404
        },
        "/.well-known/openid-configuration": {
          "body": "",
          "status": 404
        }
      }
    },
    {
      "check": "oauthDiscovery",
      "description": "Both metadata paths unreachable; not absence proof.",
      "domain": "auth-blocked.example.com",
      "expected_applicability": "UNDETERMINED",
      "expected_status": "UNKNOWN",
      "id": "OD-04",
      "mocks": {
        "/.well-known/oauth-authorization-server": {
          "error": "SSRFBlocked: Access to private IP blocked"
        },
        "/.well-known/openid-configuration": {
          "error": "SSRFBlocked: Access to private IP blocked"
        }
      }
    },
    {
      "check": "oauthDiscovery",
      "description": "HTTP 200 with non-JSON body is not correctness.",
      "domain": "auth-html.example.com",
      "expected_applicability": "APPLICABLE",
      "expected_status": "FAIL",
      "id": "OD-05",
      "mocks": {
        "/.well-known/oauth-authorization-server": {
          "body": "<html>not json</html>",
          "content_type": "text/html",
          "status": 200
        },
        "/.well-known/openid-configuration": {
          "body": "",
          "status": 404
        }
      }
    },
    {
