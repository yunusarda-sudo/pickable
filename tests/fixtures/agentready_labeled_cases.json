          "content_type": "application/json",
          "body": "{\"issuer\": \"https://auth-oauth.example.com\", \"authorization_endpoint\": \"https://auth-oauth.example.com/authorize\", \"token_endpoint\": \"https://auth-oauth.example.com/token\", \"jwks_uri\": \"https://auth-oauth.example.com/jwks.json\"}"
